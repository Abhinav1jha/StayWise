# Server
PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/staywise

# JWT — replace with a strong random secret (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Gemini — required for AI review analysis (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
